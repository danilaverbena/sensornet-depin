{
  "name": "sensornet-mobile",
  "version": "1.0.0",
  "description": "SensorNet — Decentralized Physical Infrastructure Network (DePIN) for Cellular, Wi-Fi, and Road Surface Telemetry on Solana Mobile Seeker",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "contract:build": "cd contracts && anchor build",
    "contract:test": "cd contracts && anchor test",
    "relayer:start": "cd relayer && npm run start"
  },
  "dependencies": {
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.1.4",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.1.4",
    "@solana/web3.js": "^1.95.4",
    "@solana/spl-token": "^0.4.9",
    "@coral-xyz/anchor": "^0.30.1",
    "buffer": "^6.0.3",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-svg": "^15.9.0",
    "react-native-sensors": "^7.3.6",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-network-info": "^5.2.1",
    "h3-js": "^4.1.0",
    "lucide-react-native": "^0.460.0",
    "react-native-reanimated": "~3.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
